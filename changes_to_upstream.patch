--- /dev/null
+++ b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.cpp
@@ -0,0 +1,134 @@
+#include "MultiModeObs.h"
+#include <RLGymCPP/Gamestates/StateUtil.h>
+#include "../Math.h"
+
+void RLGC::MultiModeObs::AddPlayerInputs(FList& obs, const Player& player, const PhysState& phys, const PhysState& ball) {
+	obs += phys.pos * POS_COEF;
+	obs += phys.rotMat.forward;
+	obs += phys.rotMat.up;
+	obs += phys.vel * VEL_COEF;
+	obs += phys.angVel * ANG_VEL_COEF;
+	obs += phys.rotMat.Dot(phys.angVel) * ANG_VEL_COEF;
+
+	obs += phys.rotMat.Dot(ball.pos - phys.pos) * POS_COEF;
+	obs += phys.rotMat.Dot(ball.vel - phys.vel) * VEL_COEF;
+
+	obs += player.boost / 100;
+	obs += (float)player.isOnGround;
+	obs += (float)player.HasFlipOrJump();
+	obs += (float)player.isDemoed;
+	obs += (float)player.hasJumped; // Allows detecting flip resets
+	obs += (float)player.isSupersonic;
+}
+
+int RLGC::MultiModeObs::GetMirroredPadIndex(int padIndex) {
+	struct Table {
+		int indices[CommonValues::BOOST_LOCATIONS_AMOUNT];
+
+		Table() {
+			for (int i = 0; i < CommonValues::BOOST_LOCATIONS_AMOUNT; i++) {
+				Vec target = CommonValues::BOOST_LOCATIONS[i] * Vec(-1, 1, 1);
+
+				// The nearest pad to the mirrored position (the game's pad positions are symmetric to within 2 units)
+				int best = 0;
+				for (int j = 1; j < CommonValues::BOOST_LOCATIONS_AMOUNT; j++)
+					if (CommonValues::BOOST_LOCATIONS[j].DistSq(target) < CommonValues::BOOST_LOCATIONS[best].DistSq(target))
+						best = j;
+				indices[i] = best;
+			}
+		}
+	};
+	static const Table table = {};
+	return table.indices[padIndex];
+}
+
+RLGC::FList RLGC::MultiModeObs::BuildObs(const Player& player, const GameState& state) {
+	FList obs = {};
+	obs.reserve(OBS_SIZE);
+
+	bool inv = player.team == Team::ORANGE;
+
+	// Mirrored view: everything below is built from the game with left and right swapped (see ObsBuilder::mirrorXTeam)
+	bool mirror = IsMirroredX(player);
+
+	auto ball = MirrorPhysX(InvertPhys(state.ball, inv), mirror);
+	auto& pads = state.GetBoostPads(inv);
+	auto& padTimers = state.GetBoostPadTimers(inv);
+
+	for (int i = 0; i < NUM_PAD_INPUTS; i++) {
+		int padIdx = mirror ? GetMirroredPadIndex(i) : i;
+		obs += pads[padIdx] ? 1.f : (1.f / (1.f + padTimers[padIdx])); // Approaches 1 as the pad becomes available
+	}
+
+	{ // Game mode
+		int teamSizes[2] = {};
+		for (auto& otherPlayer : state.players)
+			teamSizes[(int)otherPlayer.team]++;
+
+		int modeIdx = GetModeIndex(teamSizes[0], teamSizes[1]);
+		for (int i = 0; i < NUM_MODE_INPUTS; i++)
+			obs += (float)(i == modeIdx);
+	}
+
+	obs += ball.pos * POS_COEF;
+	obs += ball.vel * VEL_COEF;
+	obs += ball.angVel * ANG_VEL_COEF;
+
+	auto selfPhys = MirrorPhysX(InvertPhys(player, inv), mirror);
+	AddPlayerInputs(obs, player, selfPhys, ball);
+	{
+		Action prevAction = player.prevAction;
+		if (mirror)
+			MirrorActionX(prevAction);
+		for (int i = 0; i < NUM_PREV_ACTION_INPUTS; i++)
+			obs += prevAction[i];
+	}
+
+	// Player slots
+	float selfBallDist = (ball.pos - selfPhys.pos).Length();
+	const int groupSlots[2] = { NUM_TEAMMATE_SLOTS, NUM_OPPONENT_SLOTS };
+	std::vector<FList> groups[2] = {};
+
+	for (auto& otherPlayer : state.players) {
+		if (otherPlayer.carId == player.carId)
+			continue;
+
+		bool isTeammate = otherPlayer.team == player.team;
+		auto& group = groups[isTeammate ? 0 : 1];
+		if (group.size() >= groupSlots[isTeammate ? 0 : 1]) {
+			RG_ERR_CLOSE(
+				"MultiModeObs: Too many " << (isTeammate ? "teammates" : "opponents") << ", the observation has slots for " <<
+				NUM_TEAMMATE_SLOTS << " teammates and " << NUM_OPPONENT_SLOTS << " opponents (" << state.players.size() << " players are in this game)"
+			);
+		}
+
+		auto phys = MirrorPhysX(InvertPhys(otherPlayer, inv), mirror);
+
+		FList slot = {};
+		slot.reserve(SLOT_SIZE);
+		slot += 1.f;
+		slot += (float)isTeammate;
+		AddPlayerInputs(slot, otherPlayer, phys, ball);
+
+		Vec relPos = phys.pos - selfPhys.pos;
+		slot += relPos * POS_COEF;
+		slot += (phys.vel - selfPhys.vel) * VEL_COEF;
+		slot += selfPhys.rotMat.Dot(relPos) * POS_COEF;
+		slot += ((ball.pos - phys.pos).Length() - selfBallDist) * POS_COEF;
+
+		group.push_back(slot);
+	}
+
+	for (int i = 0; i < 2; i++) {
+		auto& group = groups[i];
+		group.resize(groupSlots[i], FList(SLOT_SIZE, 0));
+
+		if (shuffleSlots)
+			std::shuffle(group.begin(), group.end(), ::Math::GetRandEngine());
+
+		for (auto& slot : group)
+			obs += slot;
+	}
+
+	return obs;
+}
diff --git a/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.h b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.h
new file mode 100644
index 0000000..0d0309b
--- /dev/null
+++ b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include "ObsBuilder.h"
+
+namespace RLGC {
+	// An observation with one fixed size and layout for 1v1, 2v2 and 3v3, so that one network can play all three.
+	//
+	// Layout (294 inputs). Everything is seen from the observing player's side of the field
+	//	(for orange players the field is rotated by 180 degrees, so the own goal is always at -Y):
+	//
+	//	Global inputs (84)
+	//		[  0.. 33]  Boost pads: 1 if available, otherwise 1/(1 + seconds until it is back)
+	//		[ 34.. 36]  Game mode, one-hot: 1v1, 2v2, 3v3 (by the size of the bigger team)
+	//		[ 37.. 45]  Ball: position, velocity, angular velocity
+	//		[ 46.. 75]  The observing player (see "Player inputs" below)
+	//		[ 76.. 83]  The observing player's previous action (throttle, steer, pitch, yaw, roll, jump, boost, handbrake)
+	//
+	//	5 player slots of 42 inputs each: 2 for teammates, then 3 for opponents.
+	//	Slots without a player are all zeros. Used slots are filled from the front of their group, in no meaningful order.
+	//		[0]         1 = this slot is used
+	//		[1]         1 = teammate, 0 = opponent
+	//		[2..31]     Player inputs
+	//		[32..34]    Position relative to the observing player
+	//		[35..37]    Velocity relative to the observing player
+	//		[38..40]    Position relative to the observing player, in the observing player's car frame (forward, right, up)
+	//		[41]        Distance to the ball, minus the observing player's distance to the ball (negative = this player is closer)
+	//
+	//	Player inputs (30):
+	//		position, forward direction, up direction, velocity, angular velocity,
+	//		angular velocity / ball position / ball velocity in the car's own frame,
+	//		boost, on ground, has a flip or jump left, is demolished, has jumped, is supersonic
+	//
+	// Every input can also be read from the game through RLBot.
+	//
+	// For networks: [GLOBAL_SIZE global inputs][NUM_SLOTS slots of SLOT_SIZE]. The last CONTEXT_SIZE global inputs (mode, ball,
+	//	own car) describe the observing player's situation, which is what a slot has to be compared with.
+	class MultiModeObs : public ObsBuilder {
+	public:
+		constexpr static float
+			POS_COEF = 1 / 5000.f,
+			VEL_COEF = 1 / 2300.f,
+			ANG_VEL_COEF = 1 / 3.f;
+
+		constexpr static int
+			MAX_TEAM_SIZE = 3,
+			NUM_TEAMMATE_SLOTS = MAX_TEAM_SIZE - 1,
+			NUM_OPPONENT_SLOTS = MAX_TEAM_SIZE,
+			NUM_SLOTS = NUM_TEAMMATE_SLOTS + NUM_OPPONENT_SLOTS,
+
+			NUM_PAD_INPUTS = CommonValues::BOOST_LOCATIONS_AMOUNT,
+			NUM_MODE_INPUTS = MAX_TEAM_SIZE,
+			NUM_BALL_INPUTS = 9,
+			NUM_PLAYER_INPUTS = 30,
+			NUM_PREV_ACTION_INPUTS = (int)Action::ELEM_AMOUNT,
+
+			GLOBAL_SIZE = NUM_PAD_INPUTS + NUM_MODE_INPUTS + NUM_BALL_INPUTS + NUM_PLAYER_INPUTS + NUM_PREV_ACTION_INPUTS,
+			CONTEXT_SIZE = GLOBAL_SIZE - NUM_PAD_INPUTS,
+
+			NUM_SLOT_EXTRA_INPUTS = 12,
+			SLOT_SIZE = NUM_PLAYER_INPUTS + NUM_SLOT_EXTRA_INPUTS,
+
+			OBS_SIZE = GLOBAL_SIZE + NUM_SLOTS * SLOT_SIZE;
+
+		// Puts the players of each group into their slots in a random order (empty slots anywhere).
+		// Only needed for networks that treat every slot differently (a plain MLP on the whole observation),
+		//	so that they can't get used to a slot order. Networks that pool over the slots don't need it.
+		bool shuffleSlots;
+
+		MultiModeObs(bool shuffleSlots = false) : shuffleSlots(shuffleSlots) {}
+
+		// Index of the game mode input that is set for a game with these team sizes (0 = 1v1, 1 = 2v2, 2 = 3v3)
+		static int GetModeIndex(int teamSizeA, int teamSizeB) {
+			return RS_CLAMP(RS_MAX(teamSizeA, teamSizeB), 1, MAX_TEAM_SIZE) - 1;
+		}
+
+		virtual FList BuildObs(const Player& player, const GameState& state) override;
+
+		// The mirrored view (see ObsBuilder::mirrorXTeam) is implemented
+		virtual bool SupportsMirrorX() const override { return true; }
+
+		// Index of the boost pad on the other side of the field (x -> -x)
+		static int GetMirroredPadIndex(int padIndex);
+
+	protected:
+		// Adds the NUM_PLAYER_INPUTS inputs of a player. "phys" and "ball" must already be from the observing player's side
+		static void AddPlayerInputs(FList& obs, const Player& player, const PhysState& phys, const PhysState& ball);
+	};
+}
diff --git a/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/ObsBuilder.h b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/ObsBuilder.h
index 39796ea..98e7155 100644
--- a/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/ObsBuilder.h
+++ b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/ObsBuilder.h
@@ -7,6 +7,41 @@
 namespace RLGC {
 	class ObsBuilder {
 	public:
+		// Mirrored view, per team (index 0 = blue, 1 = orange): 0 = off, 1 = right, -1 = left.
+		// Set through EnvSet::SetMirrorX() or InferUnit::SetMirrorX().
+		//
+		// The field, the cars and the rules are the same when left and right are swapped. With the mirrored view "right",
+		// a player whose car is on the left half of the field (seen from its own goal) gets the whole game mirrored,
+		// so that the network only ever sees its own car on the right half. It then has to learn every situation once
+		// instead of twice. The action that the network picks for the mirrored game is mirrored back before it is applied.
+		// "left" is the same with the halves swapped.
+		//
+		// A policy has to be used with the view it was trained with, so this is a property of a checkpoint.
