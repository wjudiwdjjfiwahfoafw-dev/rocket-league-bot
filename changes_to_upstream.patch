diff --git a/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.cpp b/GigaLearnCPP/RLGymCPP/src/RLGymCPP/ObsBuilders/MultiModeObs.cpp
new file mode 100644
