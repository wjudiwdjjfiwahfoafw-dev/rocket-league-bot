+			// Normalize, apply the layer norm's weight and bias, then the ReLU
+			j = 0;
+			for (; j + VEC_SIZE <= d; j += VEC_SIZE) {
+				FVec zHat = VEC_LOAD(zRow + j) * rowRstd;
