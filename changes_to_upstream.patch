+void RLGC::EnvSet::SetMirrorX(int blueTeam, int orangeTeam) {
+	bool changed = false;
+	for (ObsBuilder* obsBuilder : obsBuilders) {
+		if (obsBuilder->mirrorXTeam[0] == blueTeam && obsBuilder->mirrorXTeam[1] == orangeTeam)
+			continue;
+
+		if ((blueTeam || orangeTeam) && !obsBuilder->SupportsMirrorX())
+			RG_ERR_CLOSE("EnvSet::SetMirrorX(): The obs builder does not support the mirrored view");
+
+		obsBuilder->mirrorXTeam[0] = blueTeam;
+		obsBuilder->mirrorXTeam[1] = orangeTeam;
+		changed = true;
+	}
+
+	if (changed) {
+		// The observations of the current states were built with the old setting.
+		// The next actions are picked from them and are mirrored back with the new setting, so they have to match
+		for (int arenaIdx = 0; arenaIdx < arenas.size(); arenaIdx++) {
+			auto& gs = state.gameStates[arenaIdx];
+			int playerStartIdx = state.arenaPlayerStartIdx[arenaIdx];
+			for (int i = 0; i < gs.players.size(); i++)
+				state.obs.Set(playerStartIdx + i, obsBuilders[arenaIdx]->BuildObs(gs.players[i], gs));
+		}
+	}
+}
